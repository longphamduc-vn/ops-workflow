import os

import xml.etree.ElementTree as ET

import requests







class NexacroService:

    # Định nghĩa đường dẫn trỏ tới thư mục chứa các file XML mẫu

    TEMPLATE_DIR = os.path.join(

        os.path.dirname(os.path.abspath(__file__)), "templates"

    )




    @classmethod

    def _read_template(cls, filename: str) -> str:

        """Đọc nội dung văn bản thô từ file XML mẫu"""

        file_path = os.path.join(cls.TEMPLATE_DIR, filename)

        with open(file_path, "r", encoding="utf-8") as f:

            return f.read()




    @classmethod

    def build_request_xml(cls, items: list) -> str:

        """[Step 1] Đọc template và thay thế danh sách item nhập từ UI"""

        template = cls._read_template("step1_req.xml")

        rows_xml = "\n".join(

            [f'\t\t\t<Row><Col id="item">{item}</Col></Row>' for item in items]

        )

        # Dùng .replace() để không bao giờ bị lỗi xung đột dấu ngoặc nhọn {} của file XML gốc

        return template.replace("__ROWS_XML__", rows_xml)




    @classmethod

    def build_step2_xml(cls, inventory_item_id: str) -> str:

        """[Step 2] Đọc template và bơm chính xác duy nhất 1 ID của vòng lặp"""

