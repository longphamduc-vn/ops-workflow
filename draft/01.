import os

import xml.etree.ElementTree as ET

import requests







class NexacroService:

    # Định nghĩa đường dẫn trỏ tới thư mục chứa các file XML mẫu

    TEMPLATE_DIR = os.path.join(

        os.path.dirname(os.path.abspath(__file__)), "templates"

    )




    @classmethod

    def _read_template(cls, filename: str) -> str:

        """Đọc nội dung văn bản thô từ file XML mẫu"""

        file_path = os.path.join(cls.TEMPLATE_DIR, filename)

        with open(file_path, "r", encoding="utf-8") as f:

            return f.read()




    @classmethod

    def build_request_xml(cls, items: list) -> str:

        """[Step 1] Đọc template và thay thế danh sách item nhập từ UI"""

        template = cls._read_template("step1_req.xml")

        rows_xml = "\n".join(

            [f'\t\t\t<Row><Col id="item">{item}</Col></Row>' for item in items]

        )

        # Dùng .replace() để không bao giờ bị lỗi xung đột dấu ngoặc nhọn {} của file XML gốc

        return template.replace("__ROWS_XML__", rows_xml)




    @classmethod

    def build_step2_xml(cls, inventory_item_id: str) -> str:

        """[Step 2] Đọc template và bơm chính xác duy nhất 1 ID của vòng lặp"""

        template = cls._read_template("step2_req.xml")

        # Thay thế chuỗi đánh dấu bằng ID thực tế một cách an toàn

        return template.replace("__INVENTORY_ITEM_ID__", str(inventory_item_id))




    @classmethod

    def build_step3_xml(cls, item: str, item_desc: str, inventory_item_id: str) -> str:

        """[Step 3] Đọc template và thay thế đồng thời 3 trường động từ kết quả Step 1"""

        template = cls._read_template("step3_req.xml")

        

        # Thay thế tuần tự 3 chuỗi đánh dấu bằng dữ liệu thực tế

        xml_output = template.replace("__ITEM__", str(item))

        xml_output = xml_output.replace("__ITEM_DESC__", str(item_desc))

        xml_output = xml_output.replace("__INVENTORY_ITEM_ID__", str(inventory_item_id))

        return xml_output




    @staticmethod

    def send_post_request(url: str, xml_data: str) -> str:

        """Thực hiện bắn HTTP POST"""

        headers = {"Content-Type": "application/xml; charset=UTF-8"}

        response = requests.post(

            url, data=xml_data.encode("utf-8"), headers=headers, timeout=30

        )

        response.raise_for_status()

        return response.text




    @staticmethod

    def parse_response_xml(xml_response_text: str) -> tuple:

        """Phân tích XML nhận về từ server để lấy errorMsg và danh sách dữ liệu hàng.

        Sửa lỗi: Kiểm tra điều kiện strip() văn bản để không làm hỏng Step 1 khi nhận thẻ trống,

        đồng thời hỗ trợ tìm kiếm linh hoạt lỗi ErrorMsg không có Namespace của Step 3.

        """

        root = ET.fromstring(xml_response_text)

        ns = {"ns": "http://www.nexacroplatform.com/platform/dataset"}




        error_msg = ""

        

        # --- 1. KIỂM TRA THÔNG BÁO LỖI (BẮT BUỘC VĂN BẢN PHẢI CÓ NỘI DUNG) ---

        

        # Cách 1: Tìm theo Namespace chuẩn (Kiểu chữ thường errorMsg)

        err_param = root.find(".//ns:Parameter[@id='errorMsg']", ns)

        if err_param is not None and err_param.text is not None:

            text_val = str(err_param.text).strip()

            if text_val: # Chỉ lấy nếu text không rỗng (Giúp Step 1 chạy bình thường)

                error_msg = text_val




        # Cách 2: Nếu chưa tìm thấy lỗi, quét linh hoạt không Namespace (Kiểu chữ hoa ErrorMsg của Step 3)

        if not error_msg:

            # Tìm tất cả các thẻ Parameter bất kể có dính ns: hay không

            all_parameters = root.findall(".//{*}Parameter")

            for param in all_parameters:

                p_id = str(param.get("id")).strip()

                if p_id in ["errorMsg", "ErrorMsg"]:

                    if param.text is not None:

                        text_val = str(param.text).strip()

                        if text_val: # Chỉ lấy nếu thực sự chứa nội dung báo lỗi

                            error_msg = text_val

                            break




        # Cách 3: Dự phòng cuối cùng nếu ErrorMsg trống hoàn toàn nhưng ErrorCode trả về là mã lỗi âm (-1)

        if not error_msg:

            for param in root.findall(".//{*}Parameter"):

                p_id = str(param.get("id")).strip()

                if p_id in ["errorCode", "ErrorCode"] and str(param.text).strip() == "-1":

                    error_msg = "Lỗi hệ thống (ErrorCode: -1 từ Server)"

                    break




        # --- 2. TRÍCH XUẤT DỮ LIỆU BẢNG (GIỮ NGUYÊN BẢN CHẠY ĐƯỢC CỦA BẠN) ---

        rows_data = []

        dataset_result = root.find(".//ns:Dataset[@id='ds_result']", ns)

        if dataset_result is not None:

            dataset_rows = dataset_result.find("ns:Rows", ns)

            if dataset_rows is not None:

                for row in dataset_rows.findall("ns:Row", ns):

                    row_dict = {}

                    for col in row.findall("ns:Col", ns):

                        col_id = col.get("id")

                        col_value = col.text if col.text is not None else ""

                        row_dict[col_id] = col_value

                    rows_data.append(row_dict)




        return error_msg, rows_data

