# ==============================================================================
# OPS-PLATFORM ROOT ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# Applies to: ops-workflow, ems-simulation, ops-portal (excluding procurement-web)
# ==============================================================================

# --- Global Platform Settings ---
PLATFORM_ENV=development
PLATFORM_TIMEZONE=Asia/Ho_Chi_Minh
GLOBAL_LOG_LEVEL=INFO

# --- Component 1: ops-workflow (Engine & API) ---
OPSFLOW_HOST=0.0.0.0
OPSFLOW_PORT=8000
OPSFLOW_ENV=development
OPSFLOW_DATABASE_URL=sqlite+aiosqlite:///opsflow.db
OPSFLOW_LOG_LEVEL=INFO
OPSFLOW_DEV=1
OPSFLOW_LOG_FILE=logs/opsflow_dev.log
OPSFLOW_WORKER_CONCURRENCY=5
OPSFLOW_WORKFLOWS_DIR=workflows
OPSFLOW_INSECURE_SKIP_VERIFY=1

# Opsflow Security & API Keys
OPSFLOW_API_AUTH_TYPE=api_key
OPSFLOW_API_KEY=test_api_key
OPSFLOW_ADMIN_KEY=admin_key
OPSFLOW_API_KEYS_HASHED={"admin_key_hash": ["admin", "runs:trigger", "runs:read", "datasets:read", "workflows:read"]}
OPSFLOW_SECRET_PROVIDER=env

# Enterprise Connectors & Outbound Webhooks Credentials
EMS_USERNAME=658359
EMS_PASSWORD=mock_ems_password_sec2026
OPSFLOW_WEBHOOK_SECRET=opsflow_wh_sec_987654321

# --- Legacy EMS Simulation (Simulator Server) ---
EMS_SIM_HOST=0.0.0.0
EMS_SIM_PORT=9000
EMS_SIM_DATABASE_URL=sqlite+aiosqlite:///ems_simulation.db
EMS_SIM_LOG_LEVEL=INFO
EMS_SIM_RECORD_PAYLOADS=true
EMS_SIM_STRICT_REQUEST_VALIDATION=true

# --- Component 2: ops-portal (Web Operations Console) ---
OPS_PORTAL_PORT=5174
VITE_PORT=5174
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=/api/v1
VITE_API_KEY=test_api_key
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

