@startuml procurement_item_registration_flow
title Quy Trình Đăng Ký, Đánh Giá Interlock & Thẩm Định Mua Sắm Phụ Tùng (Chuẩn Hóa Xưởng)

skinparam defaultFontName Arial
skinparam roundcorner 8
skinparam shadowing false
skinparam ArrowColor #2563EB
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #F8FAFC
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #F59E0B

|Kỹ Sư Hiện Trường (Requestor)|
start
:Mở Form Đăng Ký Hạng Mục Mua Hàng;

:1. Chọn Vị Trí Thiết Bị (4 Tầng Thân Thiện):
* **Line** (Chuyền) -> **Machine** (Tên máy) -> **Unit** (Khối chức năng) -> **Assembly** (Cơ cấu chi tiết);

if (Hạng mục linh kiện ĐÃ CÓ trong hệ thống?) then (Đã có sẵn)
    partition "NHÁNH ĐÃ CÓ: BỔ SUNG QCODE" {
        :2A. Nhập / Quét mã **QCode**;
        :Hệ thống tự động điền (Auto-populate):
        * Tên Item (Description) & Tên hạng mục
        * Hãng sản xuất (Maker) & Model
        * Đơn giá hợp đồng & Tồn kho;
    }
else (Chưa có trong hệ thống)
    partition "NHÁNH CHƯA CÓ: ĐĂNG KÝ MỚI" {
        :2B. Đăng Ký Tên Hạng Mục (Category):
        * Ví dụ: Khí nén, Cảm biến, Bo mạch, Gia nhiệt...;
        :3B. Đăng Ký Tên Item (Tên Linh Kiện Mới):
        * Tên chi tiết phụ tùng + Maker + Model sơ bộ;
        :4B. Đính Kèm Hồ Sơ Kỹ Thuật (Nếu có):
        * Tải folder/tệp CAD, Catalog hoặc ảnh thực tế (Mã tạm TMP-);
    }
endif

' =========================================================================
' BƯỚC 3: NHẬP SỐ LƯỢNG & THÔNG TIN NGHIỆP VỤ ĐẦY ĐỦ
' =========================================================================
partition "3. NHẬP SỐ LƯỢNG XIN MUA & BỐI CẢNH KỸ THUẬT" {
    :Nhập các thông tin bắt buộc:
    * **Số lượng xin mua** (Request Qty)
    * **Lý do sử dụng**: Setup, Cải tiến (CIP), Sự cố (Breakdown), Bảo dưỡng (PM), Dự phòng
    * **Lý do chi tiết & Logic**: Phân tích vì sao cần mua, nguyên nhân hỏng hóc
    * **Vấn đề & Hiện trạng**: Máy đang dừng hay chạy chập chờn, ảnh hưởng bao nhiêu sản lượng
    * **Cờ khẩn cấp (Urgent Flag)**: Bật cờ ưu tiên cao nếu nguy cơ dừng chuyền;
}

' =========================================================================
' BƯỚC 4: HIỂN THỊ THÔNG TIN TRẠNG THÁI INTERLOCK
' =========================================================================
|Bộ Máy Interlock & Hệ Thống|
partition "4. HIỂN THỊ THÔNG TIN TRẠNG THÁI INTERLOCK" {
    :Hệ thống quét tức thời & hiển thị 4 trạng thái Interlock:
    1. **Giá**: Đã có giá hợp đồng UP001 hay chưa có UP004 (chờ RFQ)
    2. **Tồn kho lâu (Aging Stock)**: Cảnh báo linh kiện tồn kho >30, 60, 90 ngày chưa dùng
    3. **Tồn kho pháp nhân (Entity Stock)**: Có sẵn hàng dư thừa tại pháp nhân/kho bạn
    4. **Giá cao hơn pháp nhân khác**: Cảnh báo chênh lệch đơn giá giữa các nhà máy;
}

' =========================================================================
' BƯỚC 5: TRAO ĐỔI GIỮA LEC VÀ REQUESTOR
' =========================================================================
|Chuyên Viên Điều Phối (LEC)|
partition "5. TRAO ĐỔI GIỮA LEC VÀ REQUESTOR" {
    :LEC tiếp nhận đơn đăng ký và thông tin Interlock;
    :Trao đổi trực tiếp 2 chiều với Requestor:
    * Yêu cầu làm rõ lý do sử dụng, hiện trạng máy
    * Hướng dẫn xử lý tồn kho lâu hoặc xác minh chênh lệch giá;
    |Kỹ Sư Hiện Trường (Requestor)|
    :Requestor phản hồi, bổ sung bằng chứng kỹ thuật/ảnh hiện trường;
}

' =========================================================================
' BƯỚC 6: ĐÁNH GIÁ OK -> LÊN LIST THẨM ĐỊNH
' =========================================================================
|Chuyên Viên Điều Phối (LEC)|
partition "6. ĐÁNH GIÁ OK -> LÊN LIST THẨM ĐỊNH" {
    if (LEC đánh giá hồ sơ đạt yêu cầu kỹ thuật?) then (Đạt OK)
        :LEC gom mẻ & gán nhãn Target / Over;
        :Đưa hạng mục vào **List Thẩm Định Đầu Tháng**;
    else (Chưa đạt)
        :Yêu cầu Requestor chỉnh sửa hoặc hủy đơn;
        stop
    endif
}

' =========================================================================
' BƯỚC 7: THẨM ĐỊNH OFFLINE & LEC LÀM TRUNG GIAN
' =========================================================================
|Quản Lý Chi Phí (Reviewer - Management Team)|
partition "7. THẨM ĐỊNH OFFLINE (MANAGEMENT TEAM)" {
    :Ban Quản Lý Chi Phí tiến hành Thẩm Định Offline (Ngày 01-05);
    
    if (Reviewer có thắc mắc / nghi vấn chi phí?) then (Có thắc mắc)
        :Reviewer gửi chất vấn cho LEC;
        |Chuyên Viên Điều Phối (LEC)|
        :LEC làm **Trung Gian Trao Đổi**:
        * Tiếp nhận câu hỏi từ Reviewer
        * Điều phối, hướng dẫn Requestor giải trình kỹ thuật;
        |Kỹ Sư Hiện Trường (Requestor)|
        :Requestor nộp văn bản giải trình + ảnh hiện trường;
        |Chuyên Viên Điều Phối (LEC)|
        :LEC tổng hợp và phản hồi chính thức cho Reviewer;
        |Quản Lý Chi Phí (Reviewer - Management Team)|
    endif
    
    :Reviewer phê duyệt danh mục đạt thẩm định;
}

' =========================================================================
' BƯỚC 8: CHỐT LIST MUA
' =========================================================================
|Quản Lý Chi Phí (Reviewer - Management Team)|
partition "8. CHỐT LIST MUA" {
    :Ký cấp chứng chỉ **Cost Clearance**;
    :Chốt danh sách mua chính thức của tháng;
}

' =========================================================================
' BƯỚC 9: TIẾN HÀNH MUA & XỬ LÝ TỪNG HẠNG MỤC INTERLOCK
' =========================================================================
|Hệ Thống Mua Hàng & Cổng EMS|
partition "9. TIẾN HÀNH MUA & XỬ LÝ TỪNG HẠNG MỤC INTERLOCK" {
    :Tiến hành xử lý mua theo từng hạng mục Interlock:;
    
    if (Hạng mục có tồn kho liên pháp nhân / liên team?) then (Có tồn kho)
        :Thực hiện thủ tục **Chuyển Giao (Transfer)**;
        if (Chuyển giao được Approve?) then (Approve)
            :Tiến hành xuất kho chuyển giao liên pháp nhân;
            :Hoàn tất nhận hàng chuyển giao;
            stop
        else (Reject chuyển giao)
            :Chuyển sang làm đơn đặt hàng nội bộ (**Internal PO**);
            if (Internal PO được duyệt?) then (Duyệt Internal PO)
                :Tiến hành mua qua kênh Internal PO;
                stop
            else (Reject Internal PO)
                :Chuyển sang luồng **Mua Thường (External PO)**;
            endif
        endif
    else (Không có tồn kho)
        :Chuyển thẳng sang luồng **Mua Thường (External PO)**;
    endif

    :Phát hành PO chính thức với giá thấp nhất;
    :Nhận hàng, nhập kho và xuất lắp đặt vào máy;
}

stop
@enduml
