### 5.1 Common Code Dropdowns (retComCodeList)
# Handles multiple combo queries; returns ds_output0 .. ds_output7
POST {{baseUrl}}/emscom/codeNav/retComCodeList.lgdn
Content-Type: {{xmlContentType}}
Accept: {{xmlContentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
    <Parameters>
        <Parameter id="statementName" type="string">comCode.selectComCodeList</Parameter>
        <Parameter id="comboCnt" type="string">8</Parameter>
        <Parameter id="_ems_userId" type="string">{{userId}}</Parameter>
        <Parameter id="_ems_organizationId" type="string">{{orgId}}</Parameter>
        <Parameter id="_ems_language" type="string">{{language}}</Parameter>
    </Parameters>
    <Dataset id="ds_input0">
        <ColumnInfo>
            <Column id="comCode" type="STRING" size="256"/>
            <Column id="data2Code" type="STRING" size="256"/>
            <Column id="data3Code" type="STRING" size="256"/>
            <Column id="data4Code" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
            <Row>
                <Col id="comCode">COM_WORK_ORDER_TYPE</Col>
                <Col id="data2Code"></Col>
                <Col id="data3Code"></Col>
                <Col id="data4Code"></Col>
            </Row>
        </Rows>
    </Dataset>
</Root>


