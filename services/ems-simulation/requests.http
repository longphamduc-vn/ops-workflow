### 6.1 Trigger Configured Scenario: Empty Result
# Passing _scenario="empty" in Parameters triggers the configured empty result scenario
POST {{baseUrl}}/emsspareparts/sp101/sp110Nav/RetStockStatusList.lgdn
Content-Type: {{xmlContentType}}
Accept: {{xmlContentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
    <Parameters>
        <Parameter id="_ems_userId" type="string">{{userId}}</Parameter>
        <Parameter id="_ems_organizationId" type="string">{{orgId}}</Parameter>
        <Parameter id="_scenario" type="string">empty</Parameter>
    </Parameters>
    <Dataset id="ds_search">
        <ColumnInfo>
            <Column id="organizationId" type="STRING" size="256"/>
            <Column id="itemDesc" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
            <Row>
                <Col id="organizationId">{{orgId}}</Col>
                <Col id="itemDesc">NON_EXISTING_ITEM</Col>
            </Row>
        </Rows>
    </Dataset>
</Root>

### 6.2 Unregistered Endpoint Simulation (Returns XML with errorCode="-404")
POST {{baseUrl}}/emsspareparts/unknownService/invalidApi.lgdn
Content-Type: {{xmlContentType}}
Accept: {{xmlContentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
    <Parameters>
        <Parameter id="_ems_userId" type="string">{{userId}}</Parameter>
    </Parameters>
</Root>
