# ==============================================================================
# OPS-WORKFLOW (COMPONENT 1: CORE ENGINE & API) ENVIRONMENT TEMPLATE
# ==============================================================================

ENGINE_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///opsflow.db
API_HOST=0.0.0.0
API_PORT=8000
API_AUTH_TYPE=api_key
API_KEYS_HASHED={"admin_key_hash": ["admin", "runs:trigger", "runs:read", "datasets:read", "workflows:read"]}
SECRET_PROVIDER=env
WORKER_CONCURRENCY=5
WORKFLOWS_DIR=workflows

# Real-time Execution Telemetry & Developer Logging
OPSFLOW_DEV=1
OPSFLOW_LOG_FILE=logs/opsflow_dev.log
OPSFLOW_INSECURE_SKIP_VERIFY=1

# External Connectors Credentials & Secrets
EMS_USERNAME=658359
EMS_PASSWORD=mock_ems_password_sec2026
WEBHOOK_SECRET=opsflow_wh_sec_987654321
