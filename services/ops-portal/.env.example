# ==============================================================================
# OPS-PORTAL (COMPONENT 2: OPERATIONS & DEBUG CONSOLE) ENVIRONMENT TEMPLATE
# ==============================================================================

# Local Vite Dev Server Port
VITE_PORT=5174

# Backend API Proxy Target (used by vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8000

# REST API Base URL (defaults to /api/v1 through proxy)
VITE_API_BASE_URL=/api/v1
VITE_API_KEY=test_api_key

# Global Timezone & Health URLs
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
VITE_ENGINE_HEALTH_URL=/health
VITE_EMS_SIM_URL=http://localhost:9000

